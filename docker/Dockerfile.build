ARG BASE_IMAGE=debian:trixie-slim
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
  && rm -rf /var/lib/apt/lists/*

COPY scripts /usr/local/lib/podman-deb-build/scripts
RUN chmod +x /usr/local/lib/podman-deb-build/scripts/*.sh \
  && test -x /usr/local/lib/podman-deb-build/scripts/build-deb-from-dsc.sh \
  && test -x /usr/local/lib/podman-deb-build/scripts/install-build-deps.sh

ENTRYPOINT ["/usr/local/lib/podman-deb-build/scripts/build-podman-stack.sh"]
